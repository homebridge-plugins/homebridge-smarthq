{
  "pluginAlias": "SmartHQ",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "customUiPath": "./dist/homebridge-ui",
  "headerDisplay": "<p align='center'><img width='250px' src='https://raw.githubusercontent.com/homebridge-plugins/homebridge-smarthq/latest/branding/Homebridge_x_SmartHQ.svg'></p>\n\nThe **Homebridge SmartHQ** plugin allows you to interact with SmartHQ devices from HomeKit and Siri.",
  "footerDisplay": "Your SmartHQ account was linked. Please raise any issues on our [project page](https://github.com/homebridge-plugins/homebridge-smarthq/issues).\n\nIf you would like to have other features, please open a [feature request](https://github.com/homebridge-plugins/homebridge-smarthq/issues/new/choose).",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "title": "Name",
        "default": "SmartHQ",
        "required": true
      },
      "credentials": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "title": "Username",
            "placeholder": "apple@icloud.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "title": "Password",
            "format": "password",
            "placeholder": "***************",
            "x-schema-form": {
              "type": "password"
            }
          },
          "notice": {
            "title": "Notice",
            "type": "string",
            "default": "Keep your username and password a secret!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "devices": {
        "type": "array",
        "items": {
          "title": "Devices",
          "type": "object",
          "properties": {
            "configDeviceName": {
              "title": "Device Name",
              "type": "string",
              "placeholder": "Dishwasher",
              "description": "This is the name that will be used to identify the device in HomeKit."
            },
            "applianceId": {
              "title": "Application ID",
              "type": "string",
              "placeholder": "FCB97E120A84",
              "description": "This is devices unique applicationId."
            },
            "hide_device": {
              "title": "Hide Device",
              "type": "boolean",
              "default": false,
              "description": "If enabled, the device will not be added to HomeKit.",
              "condition": {
                "functionBody": "return (model.devices && model.devices[arrayIndices].applianceId);"
              }
            },
            "useMatter": {
              "title": "Enable Matter",
              "type": "boolean",
              "default": false,
              "description": "If enabled, the device will use Matter for HomeKit integration (if supported).",
              "condition": {
                "functionBody": "return (model.devices && model.devices[arrayIndices].applianceId && !model.options.devices[arrayIndices].hide_device);"
              }
            },
            "matterOnly": {
              "title": "Matter Only (No HAP Fallback)",
              "type": "boolean",
              "default": false,
              "description": "If enabled, the device will NOT fall back to HAP when Matter is unavailable. The accessory will not be published if Matter support is missing.",
              "condition": {
                "functionBody": "return (model.devices && model.devices[arrayIndices].applianceId && !model.devices[arrayIndices].hide_device && model.devices[arrayIndices].useMatter);"
              }
            },
            "keurig": {
              "title": "Keurig K-Cup Hot Water Services",
              "type": "boolean",
              "description": "Enable HomeKit services for the built-in Keurig K-Cup brewer on refrigerators that have one (e.g. PYE22PYNHFS). Leave unset to auto-detect from the appliance. Set false to disable even on supported models. Set true to force-enable if auto-detect misfires.",
              "condition": {
                "functionBody": "return (model.devices && model.devices[arrayIndices].applianceId && !model.devices[arrayIndices].hide_device);"
              }
            },
            "keurigOnly": {
              "title": "Keurig Only (Hide Main Refrigerator)",
              "type": "boolean",
              "description": "On a refrigerator with a built-in Keurig, skip the main Refrigerator HomeKit accessory and publish only the Keurig sub-accessory. Useful if you only care about the coffee maker and want to declutter Apple Home.",
              "condition": {
                "functionBody": "return (model.devices && model.devices[arrayIndices].applianceId && !model.devices[arrayIndices].hide_device);"
              }
            },
            "firmware": {
              "title": "Firmware Override",
              "type": "string",
              "placeholder": "1.2.8",
              "condition": {
                "functionBody": "return (model.devices && model.devices[arrayIndices].applianceId && !model.options.devices[arrayIndices].hide_device);"
              }
            },
            "refreshRate": {
              "title": "Device Refresh Rate",
              "type": "number",
              "minimum": 1800,
              "placeholder": 1800,
              "description": "Indicates the number of seconds between polls of the SmartHQ service.",
              "condition": {
                "functionBody": "return (model.devices && model.devices[arrayIndices].applianceId && !model.options.devices[arrayIndices].hide_device);"
              }
            },
            "logging": {
              "title": "Device Logging Override Setting",
              "type": "string",
              "required": true,
              "default": "",
              "oneOf": [
                {
                  "title": "Default Logging",
                  "enum": [
                    ""
                  ]
                },
                {
                  "title": "Standard Logging",
                  "enum": [
                    "standard"
                  ]
                },
                {
                  "title": "No Logging",
                  "enum": [
                    "none"
                  ]
                },
                {
                  "title": "Debug Logging",
                  "enum": [
                    "debug"
                  ]
                }
              ],
              "condition": {
                "functionBody": "return (model.devices && model.devices[arrayIndices].applianceId && !model.devices[arrayIndices].hide_device);"
              }
            },
            "defaultOperationMode": {
              "title": "Default Operation Mode (Air Conditioners)",
              "type": "string",
              "default": "cool",
              "description": "The SmartHQ mode applied when the air conditioner service is switched on in HomeKit. Only applies to air conditioners.",
              "oneOf": [
                {
                  "title": "Cool",
                  "enum": [
                    "cool"
                  ]
                },
                {
                  "title": "Fan Only",
                  "enum": [
                    "fanOnly"
                  ]
                },
                {
                  "title": "Energy Saver",
                  "enum": [
                    "energySaver"
                  ]
                },
                {
                  "title": "Heat",
                  "enum": [
                    "heat"
                  ]
                },
                {
                  "title": "Dry",
                  "enum": [
                    "dry"
                  ]
                }
              ],
              "condition": {
                "functionBody": "return (model.devices && model.devices[arrayIndices].applianceId && !model.devices[arrayIndices].hide_device);"
              }
            },
            "createSeparateFanService": {
              "title": "Separate Fan Service (Air Conditioners)",
              "type": "boolean",
              "default": false,
              "description": "If enabled, a separate fan service is exposed for fan-speed control (0% = auto, 1-33% = low, 34-66% = medium, 67-100% = high). Only applies to air conditioners.",
              "condition": {
                "functionBody": "return (model.devices && model.devices[arrayIndices].applianceId && !model.devices[arrayIndices].hide_device);"
              }
            },
            "showDryModeSwitch": {
              "title": "Show Dry Mode Switch (Air Conditioners)",
              "type": "boolean",
              "default": true,
              "description": "If disabled, the dry mode switch is not exposed in HomeKit. Only applies to air conditioners.",
              "condition": {
                "functionBody": "return (model.devices && model.devices[arrayIndices].applianceId && !model.devices[arrayIndices].hide_device);"
              }
            },
            "showHeatMode": {
              "title": "Show Heat Mode (Air Conditioners)",
              "type": "boolean",
              "default": true,
              "description": "If disabled, heat is removed from the HomeKit mode selector and the heat mode switch is not exposed. Turn this off for cooling-only models. Only applies to air conditioners.",
              "condition": {
                "functionBody": "return (model.devices && model.devices[arrayIndices].applianceId && !model.devices[arrayIndices].hide_device);"
              }
            },
            "showRunningSwitch": {
              "title": "Show Running Switch",
              "type": "boolean",
              "default": false,
              "description": "Washers and dryers only: expose a read-only switch that shows whether the machine is running."
            },
            "showFilterBattery": {
              "title": "Show Filter Life As Battery",
              "type": "boolean",
              "default": false,
              "description": "Water filters only: expose the filter life percentage as a battery, so it is visible at a glance in HomeKit with a low warning at 10%."
            }
          },
          "required": [
            "applianceId",
            "configDeviceName"
          ]
        }
      },
      "options": {
        "type": "object",
        "properties": {
          "refreshRate": {
            "title": "Refresh Rate",
            "type": "number",
            "minimum": 30,
            "placeholder": 120,
            "description": "Indicates the number of seconds between polls of the Meater service."
          },
          "updateRate": {
            "title": "Update Rate",
            "type": "number",
            "minimum": 30,
            "placeholder": 30,
            "description": "How frequently in seconds that HomeKit accessories are updated"
          },
          "homekitControllerNotificationsSecret": {
            "title": "Homekit Controller Notifications Secret",
            "type": "string",
            "placeholder": "xxxxxx",
            "default": "",
            "x-schema-form": {
              "type": "password"
            }
          },
          "logging": {
            "title": "Logging Setting",
            "type": "string",
            "required": true,
            "default": "",
            "oneOf": [
              {
                "title": "Default Logging",
                "enum": [
                  ""
                ]
              },
              {
                "title": "Standard Logging",
                "enum": [
                  "standard"
                ]
              },
              {
                "title": "No Logging",
                "enum": [
                  "none"
                ]
              },
              {
                "title": "Debug Logging",
                "enum": [
                  "debug"
                ]
              }
            ]
          },
          "region": {
            "title": "Account Region",
            "type": "string",
            "default": "",
            "description": "The region of your SmartHQ account. Leave as default unless the login page resolves to the wrong region (for example a US account behind European DNS).",
            "oneOf": [
              {
                "title": "Default (Auto)",
                "enum": [
                  ""
                ]
              },
              {
                "title": "United States",
                "enum": [
                  "us"
                ]
              },
              {
                "title": "Europe",
                "enum": [
                  "eu"
                ]
              }
            ]
          }
        },
        "required": [
          "logging"
        ]
      }
    }
  },
  "layout": [
    {
      "type": "fieldset",
      "title": "SmartHQ Account Info",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "type": "help",
          "helpvalue": "<h5></h5><em class='primary-text'>This is for Manual Setup Only.</em>"
        },
        "credentials.username",
        "credentials.password"
      ]
    },
    {
      "type": "fieldset",
      "title": "SmartHQ Device Settings",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "key": "devices",
          "notitle": true,
          "type": "tabarray",
          "title": "{{ value.configDeviceName || value.applianceId || 'New SmartHQ Device' }}",
          "expandable": true,
          "expanded": false,
          "orderable": false,
          "items": [
            "devices[].configDeviceName",
            "devices[].applianceId",
            "devices[].useMatter",
            "devices[].matterOnly",
            "devices[].keurig",
            "devices[].keurigOnly",
            "devices[].hide_device",
            "devices[].defaultOperationMode",
            "devices[].createSeparateFanService",
            "devices[].showDryModeSwitch",
            "devices[].showHeatMode",
            "devices[].showRunningSwitch",
            "devices[].showFilterBattery",
            "devices[].firmware",
            "devices[].refreshRate",
            "devices[].logging"
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Advanced Settings",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "type": "help",
          "helpvalue": "<h5>Refresh Rate</h5><em class='primary-text'>Refresh Rate indicates the number of seconds between polls of the SmartHQ service.</em>"
        },
        {
          "key": "options.refreshRate",
          "notitle": true
        },
        {
          "type": "help",
          "helpvalue": "<h5>Update Rate</h5><em class='primary-text'>Update Rate indicates how frequently in seconds HomeKit accessories are updated.</em>"
        },
        {
          "key": "options.updateRate",
          "notitle": true
        },
        {
          "type": "help",
          "helpvalue": "<h5>Homekit Controller Notifications Secret</h5><em class='primary-text'>For better notifications you can configure homekit controller, this is the secret under 'Devices & Secret'</em>"
        },
        {
          "key": "options.homekitControllerNotificationsSecret",
          "notitle": true
        },
        "options.logging",
        {
          "type": "help",
          "helpvalue": "<h5>Account Region</h5><em class='primary-text'>Set this if the SmartHQ login resolves to the wrong region for your account.</em>"
        },
        {
          "key": "options.region",
          "notitle": true
        }
      ]
    }
  ]
}
